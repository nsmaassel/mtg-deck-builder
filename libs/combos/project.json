{
  "name": "combos",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/combos/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:combos"],
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "options": { "config": "libs/combos/vite.config.ts" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": ["default", "{workspaceRoot}/scripts/data/build-combos.ts"],
      "options": {
        "command": "tsc --noEmit -p libs/combos/tsconfig.lib.json && tsc --noEmit -p libs/combos/tsconfig.spec.json && tsc --noEmit -p libs/combos/tsconfig.scripts.json"
      }
    }
  }
}
